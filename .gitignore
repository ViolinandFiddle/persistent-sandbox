# ==============================================================================
# PERSISTENT AGENT SANDBOX - Git Ignore
# ==============================================================================
# This file specifies intentionally untracked files to ignore.
# https://git-scm.com/docs/gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# GENERATED FILES (Machine-Specific)
# ------------------------------------------------------------------------------

# DevContainer configuration is generated with machine-specific mount paths
# The Dockerfile is tracked, but devcontainer.json is generated
.devcontainer/devcontainer.json

# Workspace file is generated with discovered folders
workspace.code-workspace

# Config stores machine-specific settings
config.json

# ------------------------------------------------------------------------------
# BUILD ARTIFACTS
# ------------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments (use container instead)
venv/
ENV/
env/
.venv/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# ------------------------------------------------------------------------------
# IDE / EDITOR
# ------------------------------------------------------------------------------

# VS Code (project-specific settings may be tracked)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains
.idea/
*.iml

# Vim
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# OS GENERATED
# ------------------------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ------------------------------------------------------------------------------
# LOGS & TEMP FILES
# ------------------------------------------------------------------------------

# Keep project logs tracked, but ignore any local temp logs
*.log
*.tmp
*.temp

# Don't ignore the tracked project_logs
!project_logs/
!project_logs/*.md
